{
  "parameters": {
    "username": {
      "defaultValue": "",
      "type": "string",
      "minLength": 1,
      "metadata": {
        "description": "ZeroFox account username"
      }
    },
    "apikey": {
      "defaultValue": "",
      "type": "securestring",
      "minLength": 1,
      "metadata": {
        "description": "ZeroFox Personal Access Token (PAT). Use securestring to keep credentials secure."
      }
    },
    "queryWindowInMin": {
      "defaultValue": "60",
      "type": "string",
      "allowedValues": ["60", "120", "360", "720", "1440"],
      "metadata": {
        "description": "Polling interval in minutes. 60=1h, 120=2h, 360=6h, 720=12h, 1440=1d"
      }
    }
  }
}
